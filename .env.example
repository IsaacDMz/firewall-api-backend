NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lab_guard
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SSH_HOST=firewall.example.internal
SSH_PORT=22
SSH_USERNAME=labguard
SSH_PRIVATE_KEY_PATH=/run/secrets/labguard_ssh_key
SSH_HOST_FINGERPRINT=SHA256:replace-with-the-host-key-fingerprint
SSH_CONNECT_TIMEOUT=10000
SSH_COMMAND_TIMEOUT=15000
SSH_WAN_INTERFACE=eth0
